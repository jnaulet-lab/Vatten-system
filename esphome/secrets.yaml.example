# Copier ce fichier en "secrets.yaml" et renseigner vos valeurs.
# Ne jamais committer secrets.yaml (il est dans .gitignore).

wifi_ssid: "NomDeVotreWifi"
wifi_password: "MotDePasseWifi"

# Hotspot de secours du Hub (8 caractères minimum)
ap_password: "changez-moi-vite"

# Clé API Home Assistant : générer avec  openssl rand -base64 32
api_key: "COLLER_ICI_UNE_CLE_BASE64_DE_32_OCTETS"

# Mot de passe des mises à jour OTA
ota_password: "changez-moi-aussi"
